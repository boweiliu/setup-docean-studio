# Copy to .env and fill in your DigitalOcean API key (the one hard dependency).
# Get one at https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_API_KEY=dop_v1_your_key_here

# Optional overrides (auto-discovered if unset):
# DO_REGION=sfo3
# DO_SSH_KEY_ID=        # auto: matches a DO key to your local ~/.ssh/id_ed25519.pub / id_rsa.pub
# DO_VPC_UUID=          # auto: the default-<region> VPC
